---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { socialImage } from '../lib/images';
import favicon from '../assets/lophysophy.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Section highlighted in the nav: a category slug, 'showreel' or 'about'. */
  current?: string;
  home?: boolean;
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description = SITE.description, image, current, home = false, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image ? new URL(await socialImage(image), SITE.url).href : new URL('/media/og.jpg', SITE.url).href;
const icon32 = await getImage({ src: favicon, width: 32, height: 32, format: 'png' });
const icon180 = await getImage({ src: favicon, width: 180, height: 180, format: 'png' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <link rel="icon" type="image/png" sizes="32x32" href={icon32.src}>
  <link rel="apple-touch-icon" href={icon180.src}>
  <meta name="theme-color" content="#ffffff">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <slot name="head" />
  <script is:inline>
    // Arriving through a project "portal" (see scripts/portal.ts): mark the page
    // before first paint, and skip the regular page cross-fade for this visit.
    (function () {
      try {
        var p = JSON.parse(sessionStorage.getItem('portal') || 'null');
        if (!p || p.path !== location.pathname || Date.now() - p.t > 8000) return;
        sessionStorage.removeItem('portal');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('portal-in');
        window.__portalSrc = p.src || '';
        addEventListener('pagereveal', function (e) { if (e.viewTransition) e.viewTransition.skipTransition(); });
      } catch (e) {}
    })();
  </script>
  <script is:inline data-goatcounter="https://lophysophy.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</head>
<body class:list={[{ 'is-home': home }]}>
  <script is:inline>
    // The project cover, full screen, waiting to dissolve as the page arrives.
    if (document.documentElement.classList.contains('portal-in')) {
      var portal = document.createElement('div');
      portal.className = 'portal portal--in';
      if (window.__portalSrc) portal.style.backgroundImage = 'url("' + window.__portalSrc + '")';
      document.body.appendChild(portal);
      var reveal = function () {
        var a = portal.animate(
          [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(1.08)' }],
          { duration: 760, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'both' }
        );
        a.finished.then(function () { portal.remove(); });
      };
      document.addEventListener('DOMContentLoaded', function () { requestAnimationFrame(function () { setTimeout(reveal, 60); }); });
    }
  </script>
  <a class="skip-link" href="#content">Skip to content</a>
  <Header home={home} current={current} />
  <main id="content">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/nav';
  </script>
</body>
</html>
