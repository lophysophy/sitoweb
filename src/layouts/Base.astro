---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { socialImage } from '../lib/images';
import favicon from '../assets/lophysophy.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// The fonts used above the fold, fetched early so titles don't swap visibly.
import comfortaa400 from '@fontsource/comfortaa/files/comfortaa-latin-400-normal.woff2?url';
import comfortaa700 from '@fontsource/comfortaa/files/comfortaa-latin-700-normal.woff2?url';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Section highlighted in the nav: a category slug, 'showreel' or 'about'. */
  current?: string;
  home?: boolean;
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description = SITE.description, image, current, home = false, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.author}, visual development & 2D animation`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image ? new URL(await socialImage(image), SITE.url).href : new URL('/media/og.jpg', SITE.url).href;
const icon32 = await getImage({ src: favicon, width: 32, height: 32, format: 'png' });
const icon180 = await getImage({ src: favicon, width: 180, height: 180, format: 'png' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  {[comfortaa400, comfortaa700, montserrat400].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" type="image/png" sizes="32x32" href={icon32.src}>
  <link rel="apple-touch-icon" href={icon180.src}>
  <meta name="theme-color" content="#ffffff">

  {!noindex && (
    <>
      <meta property="og:type" content="website">
      <meta property="og:site_name" content={SITE.name}>
      <meta property="og:title" content={fullTitle}>
      <meta property="og:description" content={description}>
      <meta property="og:url" content={canonical}>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content={title ? `${title}, artwork by ${SITE.author}` : `Artwork by ${SITE.author}`}>
      <meta name="twitter:card" content="summary_large_image">
    </>
  )}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <slot name="head" />
  <script is:inline data-goatcounter="https://lophysophy.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</head>
<body class:list={[{ 'is-home': home }]}>
  <a class="skip-link" href="#content">Skip to content</a>
  <Header home={home} current={current} />
  <main id="content">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/nav';
  </script>
</body>
</html>
