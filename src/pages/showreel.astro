---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="Showreel" description="2025 animation showreel by Sofia Lucarelli, alias Lophy Sophy. 2D character animation demo reel." current="showreel">
  <section class="page-head page-head--tight">
    <h1 class="page-title">Showreel</h1>
  </section>

  <section class="reel-stage">
    <div class="video-frame">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${SITE.showreelId}?autoplay=1&mute=1&rel=0&playsinline=1`}
        title="2025 showreel by Sofia Lucarelli"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </section>

  <section class="intro reel-notes">
    <p class="chip-row"><span class="chip">2D Animation</span><span class="chip">Frame-by-Frame</span></p>
    <p>A quick little video to gather all of my fav projects and animations! Enjoy :)</p>
    <p class="reel-links">
      <a class="btn" href="/animation/">See the animation projects</a>
    </p>
  </section>
</Base>
