---
import Base from '../layouts/Base.astro';
import { categories } from '../lib/portfolio';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="page-head">
    <h1 class="page-title">Lost in the sketchbook</h1>
    <p class="intro-line">This page may have been moved or renamed. Try one of these:</p>
    <p class="not-found-links">
      {categories.map((c) => <a class="btn" href={c.url}>{c.title}</a>)}
      <a class="btn" href="/showreel/">Showreel</a>
      <a class="btn btn--solid" href="/">Home</a>
    </p>
  </section>
</Base>
