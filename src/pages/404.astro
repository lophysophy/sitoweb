---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import tanuki from '../assets/tanuki.png';
import { categories } from '../lib/portfolio';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="page-head not-found">
    <Image class="not-found-tanuki" src={tanuki} alt="" widths={[220, 440]} sizes="220px" format="webp" loading="eager" fetchpriority="high" />
    <h1 class="page-title">Lost in the sketchbook</h1>
    <p class="intro-line">This page may have been moved or renamed.</p>
    <p class="not-found-links">
      <a class="btn btn--solid" href="/">Back home</a>
    </p>
    <p class="not-found-more">
      {categories.map((c, i) => <>{i > 0 && ' · '}<a class="text-link" href={c.url}>{c.title}</a></>)}
      {' · '}<a class="text-link" href="/showreel/">Showreel</a>
    </p>
  </section>
</Base>
