---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { categories, type Category } from '../../lib/portfolio';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props as { category: Category };
const cover = category.projects[0]?.coverImage;
---
<Base title={category.title} description={category.description} current={category.slug} image={cover}>
  <section class="page-head">
    <h1 class="page-title">{category.title}</h1>
    <p class="kicker tag-line">{category.tags.map((t, i, all) => <><span>{t}{i < all.length - 1 && ' ·'}</span>{i < all.length - 1 && ' '}</>)}</p>
  </section>

  <section class="intro">
    <p set:html={category.intro} />
  </section>

  <WorkGrid category={category} />

</Base>
