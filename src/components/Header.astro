---
// One bar, fixed at the top of every page, plain white. At the very top of the
// homepage it is fully clear, with white type, so the intro film shows
// untouched; scrolling brings the white in. A category panel or the phone
// menu rolls down from it as one white sheet. States are set in nav.ts.
import { CATEGORIES } from '../lib/site';
import CategoryLinks from './CategoryLinks.astro';
import NavFlyouts from './NavFlyouts.astro';

interface Props { home?: boolean; current?: string }
const { home = false, current } = Astro.props;

const cats = CATEGORIES.map((c) => ({ href: `/${c.slug}/`, label: c.title, key: c.slug }));
const main = [
  { href: '/showreel/', label: 'Showreel', key: 'showreel' },
  { href: '/about/', label: 'About', key: 'about' },
];
const aria = (key: string) => (key === current ? 'page' : undefined);
---
<header class:list={['site-header', { 'is-clear': home }]} data-site-header data-home={home ? '' : undefined}>
  <div class="header-inner">
    <div class="header-side">
      <a class="wordmark" href="/" aria-current={home ? 'page' : undefined}>Lophy Sophy</a>
    </div>
    <CategoryLinks current={current} />
    <nav class="site-nav header-side right" aria-label="Main navigation">
      {main.map((l) => <a href={l.href} aria-current={aria(l.key)}>{l.label}</a>)}
    </nav>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <NavFlyouts />
</header>

<nav class="mobile-menu" id="mobile-menu" aria-label="All sections" inert>
  <div class="mobile-menu-inner">
    {[...cats, ...main].map((l) => <a href={l.href} aria-current={aria(l.key)}>{l.label}</a>)}
  </div>
</nav>
