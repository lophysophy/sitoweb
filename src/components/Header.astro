---
// Floating nav: one glass pill holding the name and every section. A soft
// indicator glides to the hovered link and settles back on the current page.
// It steps aside while scrolling down through the work and returns on the way
// up. Over the homepage intro it turns to dark glass. On phones the links fold
// into a floating card behind the hamburger.
import { CATEGORIES } from '../lib/site';

interface Props { home?: boolean; current?: string }
const { home = false, current } = Astro.props;

const cats = CATEGORIES.map((c) => ({ href: `/${c.slug}/`, label: c.title, key: c.slug }));
const main = [
  { href: '/showreel/', label: 'Showreel', key: 'showreel' },
  { href: '/about/', label: 'About', key: 'about' },
];
const aria = (key: string) => (key === current ? 'page' : undefined);
---
<header class:list={['nav', { 'nav--hero': home }]} data-nav>
  <div class="nav-pill">
    <a class="wordmark" href="/">Lophy Sophy<span class="wordmark-sub">Sofia Lucarelli</span></a>
    <nav class="nav-links" aria-label="Main navigation">
      <span class="nav-indicator" aria-hidden="true"></span>
      {cats.map((l) => <a href={l.href} aria-current={aria(l.key)}>{l.label}</a>)}
      <span class="nav-divider" aria-hidden="true"></span>
      {main.map((l) => <a href={l.href} aria-current={aria(l.key)}>{l.label}</a>)}
    </nav>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="mobile-menu" id="mobile-menu" aria-label="All sections" inert>
  {[...cats, ...main].map((l, i) => (
    <a href={l.href} aria-current={aria(l.key)} style={`--i:${i}`}>{l.label}</a>
  ))}
</nav>
