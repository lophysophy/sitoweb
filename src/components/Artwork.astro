---
// One piece of artwork: a responsive <img>, or a silent looping <video>.
// Images are never cropped here; layout classes decide how they sit.
import type { Piece } from '../lib/portfolio';
import { responsive, resized, placeholder } from '../lib/images';

interface Props {
  piece: Piece;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  /** Lets the image open full screen in the lightbox. */
  zoom?: boolean;
  eager?: boolean;
  /** <video> only: false for synced pair rows, whose loop the script drives. */
  loop?: boolean;
}

const {
  piece,
  alt,
  sizes = '100vw',
  widths = [640, 1280, 1600],
  class: cls,
  zoom = false,
  eager = false,
  loop = true,
} = Astro.props;

const r = piece.image ? await responsive(piece.image, widths) : null;
// Clips show their first-frame still until they play. They don't autoplay from
// the markup: the page script starts each one when it comes on screen, so
// clips further down don't download up front.
const poster = piece.poster ? await resized(piece.poster, 1280) : undefined;
// The blurred preview sits behind the piece until its pixels arrive.
const blur = await placeholder(piece.stillFile);
const bg = blur ? `background-image:url(${blur})` : undefined;
---
{r ? (
  <img
    class={cls}
    src={r.src}
    srcset={r.srcset || undefined}
    sizes={r.srcset ? sizes : undefined}
    width={r.width}
    height={r.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? undefined : 'async'}
    style={bg}
    data-zoom={zoom ? r.src : undefined}
    tabindex={zoom ? 0 : undefined}
  />
) : (
  <video
    class={cls}
    src={piece.src}
    width={piece.width}
    height={piece.height}
    poster={poster}
    style={bg}
    loop={loop}
    muted
    playsinline
    preload="none"
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
  ></video>
)}
